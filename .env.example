# --- AP2 Mandate Engine ---
AP2_MANDATE_LIMIT_INR=10000.0
AP2_MANDATE_SKU=SKU-404
AP2_MANDATE_MAX_QTY=100
AP2_MANDATE_MAX_UNIT_PRICE=100.0
AP2_MANDATE_TTL_MINUTES=1440
AP2_INTENT_EXPIRY_HOURS=24

# --- Agent ---
# LLM provider: openai | anthropic | gemini | mock (mock = deterministic, no keys needed)
AGENT_LLM_PROVIDER=mock
AGENT_LLM_MODEL=gemini/gemini-3.5-flash-lite
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Razorpay ---
# Set to "remote" to use the hosted MCP server (mcp.razorpay.com/mcp),
# "mock" to use the built-in deterministic simulator (recommended for judging).
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Base64 token for remote MCP: base64("<key_id>:<key_secret>"). Leave blank to auto-derive.
RAZORPAY_MCP_TOKEN=
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp
# Optional: a real sandbox authorized payment_id to capture against (pay_...).
RAZORPAY_AUTHORIZED_PAYMENT_ID=
# Where simulated payment links are minted. Overridden when real mode is on.
RAZORPAY_DEMO_LINK_BASE=https://rzp.io/l

# --- Dashboard / notifications ---
# Where to "send" the WhatsApp fallback message: console | webhook
NOTIFY_CHANNEL=console
NOTIFY_WEBHOOK_URL=
MERCHANT_PHONE=+919000000000
SUPPLIER_NAME=Acme B2B Supplies
MERCHANT_NAME=Acme D2C Store