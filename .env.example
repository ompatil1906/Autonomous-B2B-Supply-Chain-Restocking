# --- Warden charter (per-SKU financial boundary) ---
AP2_MANDATE_LIMIT_INR=10000.0
AP2_MANDATE_SKU=SKU-404
AP2_MANDATE_MAX_QTY=100
AP2_MANDATE_MAX_UNIT_PRICE=100.0
AP2_INTENT_EXPIRY_HOURS=24
AP2_DAILY_CEILING_INR=100000.0

# --- Agent brain ---
# provider: mock | gemini | openai | anthropic
#   mock   → deterministic offline pipeline (recommended for judging, always works)
#   gemini → live reasoning incl. strategy statement; needs a valid API key
AGENT_LLM_PROVIDER=mock
AGENT_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# --- Razorpay ---
# execution mode:
#   simulation  → local deterministic simulator (turns off remote MCP calls)
#   remote_test → real Razorpay MCP in test mode; Order/Payment Link/capture tool calls
RAZORPAY_EXECUTION_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Base64 token for remote MCP: base64("<key_id>:<key_secret>"). Leave blank to auto-derive.
RAZORPAY_MCP_TOKEN=
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp
# Optional: a real sandbox authorized payment_id to capture against (pay_...).
# Without it, "capture" stays synthetic even in remote_test.
RAZORPAY_AUTHORIZED_PAYMENT_ID=
# Must equal the secret configured in your Razorpay dashboard webhook settings.
# The demo uses this same secret to synthesise signed webhooks.
RAZORPAY_WEBHOOK_SECRET=warden-sim-only-secret
# Where simulated payment links are minted.
RAZORPAY_DEMO_LINK_BASE=https://rzp.io/l

# --- Write-endpoint auth ---
# Sent as X-Warden-Token on /api/run, approvals, festival, live/probe, webhooks/simulate.
WARDEN_API_TOKEN=warden-dev-token

# --- Notifications / branding ---
NOTIFY_CHANNEL=console
NOTIFY_WEBHOOK_URL=
MERCHANT_PHONE=+917436083790
SUPPLIER_NAME=Acme B2B Supplies
MERCHANT_NAME=Acme D2C Store